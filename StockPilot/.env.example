# Copiez ce fichier vers .env et adaptez les valeurs à votre environnement.
# Ne commit jamais .env : il peut contenir des secrets.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
API_PORT=3000
# Port publié par Compose ; Vite reste sur 5173 en développement local.
WEB_PORT=8080

# PostgreSQL 16 et Redis 7 (valeurs par défaut de développement)
POSTGRES_DB=stockpilot
POSTGRES_USER=stockpilot
POSTGRES_PASSWORD=stockpilot
POSTGRES_PORT=5432
REDIS_PORT=6379
DATABASE_URL=postgresql://stockpilot:stockpilot@localhost:5432/stockpilot?schema=public
DIRECT_URL=postgresql://stockpilot:stockpilot@localhost:5432/stockpilot?schema=public
REDIS_URL=redis://localhost:6379

# Authentification : remplacez impérativement les secrets en production.
# Les valeurs par défaut ci-dessous sont uniquement destinées au développement.
JWT_ACCESS_SECRET=change-me-access-secret-with-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-with-at-least-32-characters
JWT_ACCESS_TTL=15m
REFRESH_TTL_SECONDS=604800
COOKIE_SECURE=false
CORS_ORIGIN=http://localhost:5173,http://localhost:8080

# Web local : l'API est appelée directement par Vite.
VITE_API_URL=http://localhost:3000/api/v1
# Valeur injectée dans l'image web Docker ; le reverse proxy Nginx sert /api/v1.
DOCKER_VITE_API_URL=/api/v1

# Observabilité et protection de l'API
LOG_LEVEL=info
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW="1 minute"
# Le conteneur API applique les migrations avant de démarrer.
RUN_MIGRATIONS=true
